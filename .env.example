# ====================================
# Instagram Downloader Configuration
# ====================================

# Instagram Credentials
INSTA_USERNAME=seu_usuario_instagram
INSTA_PASSWORD=sua_senha_instagram

# Target Profile (qual perfil fazer download)
INSTA_TARGET_PROFILE=seu_user

# Output Directory (onde salvar os vídeos)
OUTPUT_DIR=C:\IMAGENS\sua_pasta

# Download Settings
MAX_SCROLL_ATTEMPTS=50
DELAY_BETWEEN_REQUESTS=3
WAIT_TIMEOUT=15
HEADLESS_BROWSER=false

# Video Download Settings
VIDEO_FORMAT=best
VIDEO_RETRIES=3
VIDEO_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=downloads.log

# Proxy (opcional)
# PROXY_URL=http://proxy.example.com:8080
